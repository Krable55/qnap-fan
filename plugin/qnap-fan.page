<?php
// qnap-fan.page — Thin shim over /var/run/qfand.sock.
//
// DESIGN.md R4: this page MUST NOT poll the EC itself.  Every read goes
// through the daemon's cached snapshot via the socket.  Direct EC access
// spawns a process per read (~25x cost); a chatty page would create a
// fork storm and has already OOM-killed other processes on this box.

define('QFAND_SOCK', '/var/run/qfand.sock');
define('QFAND_TIMEOUT_S', 2);

/**
 * Send a single JSON request to qfand and return the decoded response.
 * Returns null on any error — caller shows "daemon not running" state.
 */
function daemon_query(array $request): ?array {
    if (!file_exists(QFAND_SOCK)) {
        return null;
    }
    $sock = @socket_create(AF_UNIX, SOCK_STREAM, 0);
    if ($sock === false) {
        return null;
    }
    socket_set_option($sock, SOL_SOCKET, SO_RCVTIMEO, ['sec' => QFAND_TIMEOUT_S, 'usec' => 0]);
    socket_set_option($sock, SOL_SOCKET, SO_SNDTIMEO, ['sec' => QFAND_TIMEOUT_S, 'usec' => 0]);
    if (!@socket_connect($sock, QFAND_SOCK)) {
        socket_close($sock);
        return null;
    }
    $payload = json_encode($request) . "\n";
    if (@socket_write($sock, $payload, strlen($payload)) === false) {
        socket_close($sock);
        return null;
    }
    $buf = '';
    while (true) {
        $chunk = @socket_read($sock, 4096, PHP_NORMAL_READ);
        if ($chunk === false || $chunk === '') {
            break;
        }
        $buf .= $chunk;
        if (str_ends_with(rtrim($chunk), "\n") || strpos($buf, "\n") !== false) {
            break;
        }
    }
    socket_close($sock);
    if ($buf === '') {
        return null;
    }
    $decoded = json_decode(trim($buf), true);
    return is_array($decoded) ? $decoded : null;
}

// ── Page state ──────────────────────────────────────────────────────────────

$daemon_running = false;
$status         = null;
$connect_error  = '';
$post_result    = null;

if (!file_exists(QFAND_SOCK)) {
    $connect_error = '/var/run/qfand.sock not found — daemon is not running.';
} else {
    $status = daemon_query(['op' => 'status']);
    if ($status !== null) {
        $daemon_running = true;
    } else {
        $connect_error = 'Socket exists but daemon did not respond within ' . QFAND_TIMEOUT_S . ' s.';
    }
}

// ── Handle curve POST ───────────────────────────────────────────────────────

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
    if (!$daemon_running) {
        $post_result = ['ok' => false, 'msg' => 'Daemon is not running — cannot apply changes.'];
    } elseif ($_POST['action'] === 'set_curve') {
        $channel = in_array($_POST['channel'] ?? '', ['pwm1', 'pwm7'], true)
            ? $_POST['channel']
            : null;
        $points_raw = $_POST['points'] ?? '';
        $points = json_decode($points_raw, true);
        if ($channel === null || !is_array($points)) {
            $post_result = ['ok' => false, 'msg' => 'Invalid channel or points.'];
        } else {
            $resp = daemon_query(['op' => 'set_curve', 'channel' => $channel, 'points' => $points]);
            // The daemon answers {"result":"ok"} or {"result":"error","message":…}.
            // Reading 'ok'/'msg' straight off that reply reported every
            // accepted curve as "Error: unknown".
            $post_result = $resp === null
                ? ['ok' => false, 'msg' => 'No response from daemon.']
                : ['ok' => ($resp['result'] ?? '') === 'ok',
                   'msg' => $resp['message'] ?? 'unexpected reply from daemon'];
        }
    } else {
        $post_result = ['ok' => false, 'msg' => 'Unknown action.'];
    }
}

// Helper: format a PWM value as a percentage string.
function pwm_pct(?int $pwm): string {
    if ($pwm === null) return '—';
    return $pwm . ' (' . round($pwm / 255 * 100) . '%)';
}
